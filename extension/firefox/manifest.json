{
  "applications": {
    "gecko": {
      "id": "ydm@yukii.id",
      "strict_min_version": "109.0"
    }
  },
  "background": {
    "scripts": [
      "background.js"
    ]
  },
  "browser_action": {
    "default_popup": "popup.html",
    "default_title": "Yukii Download Manager"
  },
  "description": "Alihkan unduhan browser ke Yukii Download Manager (multi-segmen, pause/resume).",
  "icons": {
    "128": "icons/icon128.png",
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png"
  },
  "manifest_version": 2,
  "name": "Yukii Download Manager",
  "options_ui": {
    "open_in_tab": true,
    "page": "options.html"
  },
  "permissions": [
    "downloads",
    "contextMenus",
    "nativeMessaging",
    "storage",
    "cookies",
    "notifications",
    "<all_urls>"
  ],
  "version": "1.1.0",
  "content_scripts": [
    {
      "matches": [
        "*://www.youtube.com/*",
        "*://youtube.com/*",
        "*://m.youtube.com/*",
        "*://music.youtube.com/*"
      ],
      "js": [
        "youtube.js"
      ],
      "css": [
        "youtube.css"
      ],
      "run_at": "document_idle"
    }
  ]
}